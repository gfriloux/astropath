#!/usr/bin/env bash
# astropath-dev — starts an *isolated* DankMaterialShell instance that loads ONLY the
# astropath plugin from the current worktree. Meant to test the in-progress version
# without touching the daily DMS (which the home-manager module manages).
#
# Isolation: dedicated XDG_CONFIG_HOME + XDG_CACHE_HOME → settings, plugin folder and
# qmlcache separate from the daily instance. The plugin symlinks (live) to the worktree's
# src/: edit, restart, and it shows up (isolated cache → no purge needed).
#
# The manifest id stays "astropath": it must stay aligned with `pluginId` in
# src/view/Settings.qml (otherwise settings are written/read under different keys).
# Only the displayed name becomes "Astropath (dev)", to tell the two bars apart.
set -euo pipefail

# Repository root (holds plugin.json + src/). Defaults to the current directory.
if [ "$#" -gt 0 ]; then
    src="$1"
    shift
else
    src="$PWD"
fi
src="$(cd "$src" && pwd)"

if [ ! -f "$src/plugin.json" ] || [ ! -d "$src/src" ]; then
    echo "astropath-dev: '$src' has no plugin.json + src/ (point it at the repository root)." >&2
    exit 1
fi
command -v dms >/dev/null || { echo "astropath-dev: 'dms' not found in PATH." >&2; exit 1; }
command -v jq  >/dev/null || { echo "astropath-dev: 'jq' not found in PATH." >&2; exit 1; }

root="${XDG_STATE_HOME:-$HOME/.local/state}/astropath-dev"
export XDG_CONFIG_HOME="$root/config"
export XDG_CACHE_HOME="$root/cache"
export XDG_STATE_HOME="$root/state"

plugindir="$XDG_CONFIG_HOME/DankMaterialShell/plugins/Astropath"
mkdir -p "$plugindir"

# plugin.json derived from the worktree: only the name changes, the id stays "astropath".
jq '.name = "Astropath (dev)"' "$src/plugin.json" >"$plugindir/plugin.json"
# live src: out-of-store symlink to the worktree.
ln -sfn "$src/src" "$plugindir/src"

echo "astropath-dev: isolated DMS instance"
echo "  source: $src/src (live)"
echo "  config: $XDG_CONFIG_HOME"
echo "  cache : $XDG_CACHE_HOME"
echo "  → enable 'Astropath (dev)' in THIS instance (Settings → Plugins)."
echo "  → on first launch the bar may overlap the top bar: move it once"
echo "    (other screen/edge) in the dev instance's settings, it persists."
echo "  (Ctrl-C to stop the dev instance.)"

# `dms run` = `qs -c dms`: without the `run` subcommand, dms only prints its usage.
exec dms run "$@"
